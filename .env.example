# URL da API Java, sem barra no final.
# No celular físico, use o IP do computador na rede (não use localhost).
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# URL do Observatório .NET (dados abertos). Vazio esconde os dados abertos no app.
EXPO_PUBLIC_OBSERVATORIO_URL=

# Hash exibido na tela Sobre o App. Vazio usa o hash automático (git local ou EAS Build).
EXPO_PUBLIC_COMMIT_HASH=
